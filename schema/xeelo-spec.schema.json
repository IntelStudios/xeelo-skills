{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://xeelo.local/schema/xeelo-spec.schema.json",
  "title": "XeeloSpec",
  "type": "object",
  "required": ["version", "kind", "object", "company", "layout"],
  "additionalProperties": false,
  "properties": {
    "version": { "type": "integer", "const": 2 },
    "kind": { "type": "string", "enum": ["create_object"] },
    "transferType": { "type": "string", "enum": ["object"], "default": "object" },
    "includes": {
      "type": "array",
      "items": { "type": "string" }
    },
    "object": {
      "type": "object",
      "required": ["name"],
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string", "minLength": 1, "maxLength": 50 },
        "code": { "type": "string", "maxLength": 255 },
        "objectType": { "type": "string", "minLength": 1, "maxLength": 50 },
        "requestTitleField": {
          "type": "string",
          "minLength": 1,
          "description": "ObjectLine code used as the request title in GUI (Object.RequestTitleObjectLineID)"
        },
        "icon": { "$ref": "#/$defs/treeIcon" },
        "color": {
          "$ref": "#/$defs/customColorCode",
          "description": "ObjectTreeColor — treeview icon color (CustomColorCode, not HEX)"
        }
      }
    },
    "objectType": {
      "type": "object",
      "additionalProperties": false,
      "description": "ObjectType tree visuals. Type name stays on object.objectType.",
      "properties": {
        "icon": { "$ref": "#/$defs/treeIcon" },
        "color": {
          "$ref": "#/$defs/customColorCode",
          "description": "ObjectTypeTreeColorBack — live Icon Color. ObjectTypeTreeColorFont is obsolete."
        }
      }
    },
    "company": {
      "type": "object",
      "required": ["name"],
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string", "minLength": 1, "maxLength": 50 },
        "icon": { "$ref": "#/$defs/treeIcon" }
      }
    },
    "layout": {
      "type": "object",
      "required": ["tabs"],
      "additionalProperties": false,
      "properties": {
        "tabs": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/tab" }
        }
      }
    },
    "onGrid": { "$ref": "#/$defs/onGrid" },
    "roles": {
      "type": "object",
      "additionalProperties": { "$ref": "#/$defs/role" }
    },
    "statuses": {
      "type": "object",
      "additionalProperties": { "$ref": "#/$defs/status" }
    },
    "workflow": { "$ref": "#/$defs/workflow" },
    "references": {
      "type": "object",
      "additionalProperties": { "$ref": "#/$defs/sourceDefinition" }
    },
    "sources": {
      "type": "object",
      "description": "Deprecated alias for references",
      "additionalProperties": { "$ref": "#/$defs/sourceDefinition" }
    },
    "lookups": {
      "type": "object",
      "additionalProperties": { "$ref": "#/$defs/lookupDefinition" }
    },
    "autonumbers": {
      "type": "object",
      "additionalProperties": { "$ref": "#/$defs/autonumberDefinition" }
    },
    "languageTable": { "$ref": "#/$defs/languageTable" },
    "ids": { "$ref": "#/$defs/ids" },
    "source": { "$ref": "#/$defs/source" },
    "transferVersion": { "type": "string", "default": "1.3.0" },
    "objectDefault": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string" },
        "order": { "type": "integer", "minimum": 0 },
        "accessOwnerLevel": { "type": "integer", "minimum": 0 },
        "isExternal": { "type": "integer", "enum": [0, 1] },
        "externalLink": { "type": "string", "format": "uuid" }
      }
    },
    "templates": {
      "type": "array",
      "items": { "$ref": "#/$defs/template" }
    },
    "objectActions": {
      "type": "array",
      "items": { "$ref": "#/$defs/objectAction" }
    },
    "updateActions": {
      "type": "array",
      "items": { "$ref": "#/$defs/updateAction" }
    },
    "objectMessages": {
      "type": "array",
      "items": { "$ref": "#/$defs/objectMessage" }
    },
    "periodics": {
      "type": "array",
      "items": { "$ref": "#/$defs/periodic" }
    }
  },
  "$defs": {
    "treeIcon": {
      "type": "string",
      "minLength": 1,
      "maxLength": 50,
      "description": "Font Awesome 6.5.1 class string as stored by Admin, e.g. fa-building fa-solid fa-fw"
    },
    "customColorCode": {
      "type": "string",
      "minLength": 1,
      "maxLength": 50,
      "description": "CustomColor.CustomColorCode (not HEX). Seed codes: data/enums/CustomColor.json"
    },
    "tab": {
      "type": "object",
      "required": ["name", "sections"],
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string" },
        "placement": { "type": "integer", "enum": [0, 1], "default": 0 },
        "order": { "type": "integer", "minimum": 1 },
        "alwaysHidden": {
          "type": "boolean",
          "description": "ObjectLineTabAlwaysHidden — hide the whole tab (typical for helper lines)"
        },
        "sections": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/section" }
        }
      }
    },
    "section": {
      "type": "object",
      "required": ["name", "width", "fields"],
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string" },
        "order": { "type": "integer", "minimum": 1 },
        "width": { "type": "integer", "minimum": 1, "maximum": 100, "default": 100 },
        "fields": {
          "type": "array",
          "items": { "$ref": "#/$defs/field" }
        }
      }
    },
    "field": {
      "type": "object",
      "required": ["name", "type"],
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string", "minLength": 1, "maxLength": 50 },
        "code": { "type": "string", "maxLength": 255 },
        "type": {
          "type": "string",
          "enum": [
            "text",
            "textarea",
            "number",
            "combobox",
            "combobox_search",
            "checkbox",
            "date",
            "attachment",
            "subgrid",
            "radio",
            "button",
            "memo",
            "empty_space",
            "web_frame",
            "report",
            "combobox_server",
            "time",
            "description_memo",
            "attachment_preview",
            "checkbox_multiselect"
          ]
        },
        "slot": { "type": "integer", "minimum": 1 },
        "width": { "type": "integer", "minimum": 1, "maximum": 100 },
        "order": { "type": "integer", "minimum": 1 },
        "mandatory": { "type": "boolean" },
        "precision": { "type": "integer", "minimum": 0, "maximum": 10 },
        "objectSubId": { "type": "integer", "minimum": 1 },
        "lookup": { "$ref": "#/$defs/lookup" },
        "reference": { "$ref": "#/$defs/reference" },
        "saveAction": { "type": "integer" },
        "attachmentStorageId": { "type": "integer", "minimum": 0 },
        "ocr": { "type": "boolean" },
        "ocrLang": { "type": "string", "maxLength": 5 },
        "imageResizeMax": { "type": "integer", "minimum": 1 },
        "mobileScan": { "type": "boolean" },
        "mobileSignature": { "type": "boolean" },
        "previewField": { "type": "string", "minLength": 1 },
        "previewDownload": { "type": "boolean" },
        "webFrameTypeId": { "type": "integer", "minimum": 1, "maximum": 4 },
        "textInputType": { "type": "integer", "minimum": 0, "maximum": 2 },
        "columnNumbers": { "type": "integer", "minimum": 1 },
        "numberSeparator": { "type": "string", "maxLength": 1 },
        "numberMin": { "type": "integer" },
        "numberMax": { "type": "integer" },
        "height": { "type": "integer", "minimum": 1 },
        "uniqueId": { "type": "integer", "minimum": 1, "maximum": 4 },
        "autonumber": {
          "type": "string",
          "minLength": 1,
          "description": "Catalog key from autonumbers:. Bind on a single default template; prefer templates.fields.<code>.autonumber when templates.yaml exists. Text only."
        },
        "descMemoBorder": {
          "type": "boolean",
          "description": "ObjectLineDescMemoIsBorder. Default false (omit or false). Set true only for a visible box."
        },
        "descMemoPadding": { "type": "integer", "minimum": 0 },
        "buttonMessage": { "type": "string" },
        "colorFont": {
          "type": "string",
          "maxLength": 50,
          "description": "ObjectLineColorFont — button text CustomColorCode (not HEX), e.g. white"
        },
        "colorBack": {
          "type": "string",
          "maxLength": 50,
          "description": "ObjectLineColorBack — button background CustomColorCode (not HEX), e.g. blue"
        },
        "isReferenceLink": { "type": "boolean" },
        "alwaysHidden": {
          "type": "boolean",
          "description": "ObjectLineIsHidden — line is not shown in GUI (definition-level, not template extended validation)"
        },
        "isActive": {
          "type": "boolean",
          "description": "ObjectLine.IsActive — false soft-disables the line (OT does not delete). Omit and the site row stays active."
        }
      }
    },
    "reference": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "referenceId": { "type": "integer", "minimum": 1 },
        "reference": { "type": "string", "minLength": 1 },
        "sourceId": { "type": "integer", "minimum": 1, "description": "Deprecated alias for referenceId" },
        "source": { "type": "string", "minLength": 1, "description": "Deprecated alias for reference" },
        "filterField": { "type": "string", "minLength": 1 }
      },
      "oneOf": [
        { "required": ["referenceId"] },
        { "required": ["reference"] },
        { "required": ["sourceId"] },
        { "required": ["source"] }
      ]
    },
    "sourceValue": {
      "type": "object",
      "required": ["value", "label"],
      "additionalProperties": false,
      "properties": {
        "value": { "type": "string" },
        "label": { "type": "string" },
        "bind": { "type": "string" },
        "order": { "type": "integer", "minimum": 0 }
      }
    },
    "sourceRefObject": {
      "type": "object",
      "required": ["objectId", "lines"],
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string" },
        "objectId": { "type": "integer", "minimum": 1 },
        "requestType": {
          "type": "string",
          "enum": ["all", "completed", "in-progress"],
          "default": "all"
        },
        "lines": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "value": { "type": "string" },
            "valueName": { "type": "string" },
            "valueBind": { "type": "string" },
            "valueFilter": { "type": "string" },
            "valueOrder": { "type": "string" }
          }
        }
      }
    },
    "sourceDefinition": {
      "type": "object",
      "required": ["name", "typeId"],
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "typeId": { "type": "integer", "minimum": 1 },
        "styleId": { "type": "integer", "minimum": 1, "default": 4 },
        "values": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/sourceValue" }
        },
        "refObject": { "$ref": "#/$defs/sourceRefObject" }
      },
      "oneOf": [
        { "required": ["values"], "not": { "required": ["refObject"] } },
        { "required": ["refObject"], "not": { "required": ["values"] } }
      ]
    },
    "lookupValue": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "source": { "type": "string" },
        "return": { "type": "string" },
        "filter": { "type": "string" },
        "sourceTo": { "type": "string" },
        "label": { "type": "string", "description": "Deprecated alias for source" },
        "value": { "type": "string", "description": "Deprecated alias for return" }
      },
      "anyOf": [
        { "required": ["source", "return"] },
        { "required": ["value"] }
      ]
    },
    "lookupDefinition": {
      "type": "object",
      "required": ["values"],
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string" },
        "matchId": { "type": "integer", "minimum": 1, "maximum": 2, "default": 1 },
        "values": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/lookupValue" }
        }
      }
    },
    "autonumberDefinition": {
      "type": "object",
      "required": ["format"],
      "additionalProperties": false,
      "properties": {
        "description": { "type": "string", "minLength": 1, "maxLength": 50 },
        "format": { "type": "string", "minLength": 1, "maxLength": 50 },
        "next": { "type": "integer", "minimum": 1, "default": 1 },
        "resetTypeId": {
          "type": "integer",
          "minimum": 1,
          "description": "ObjectLineAutoNumberResetTypeID. 1 = Yearly"
        }
      }
    },
    "lookup": {
      "type": "object",
      "required": ["sourceField"],
      "additionalProperties": false,
      "properties": {
        "lookup": { "type": "string", "minLength": 1 },
        "name": { "type": "string" },
        "sourceField": { "type": "string", "minLength": 1 },
        "filterField": { "type": "string", "minLength": 1 },
        "matchId": { "type": "integer", "minimum": 1, "maximum": 2 },
        "values": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/lookupValue" }
        }
      },
      "anyOf": [
        { "required": ["lookup"] },
        { "required": ["values"] }
      ]
    },
    "onGrid": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "fields": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "allowed": { "type": "boolean" },
              "name": { "type": "string" },
              "isTag": { "type": "boolean" },
              "isSearch": { "type": "boolean" }
            }
          }
        },
        "layouts": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["placements"],
            "additionalProperties": false,
            "properties": {
              "size": { "type": "string", "enum": ["Small", "Medium", "Large"] },
              "type": { "type": "string", "enum": ["Grid", "Table"] },
              "module": { "type": "string", "enum": ["Items", "Tasks"] },
              "placements": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": ["row", "columns"],
                  "additionalProperties": false,
                  "properties": {
                    "row": { "type": "string", "enum": ["T", "A", "B", "C", "D", "E"] },
                    "columns": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "required": ["field"],
                        "additionalProperties": false,
                        "properties": {
                          "field": { "type": "string" },
                          "position": { "type": "integer", "minimum": 0 },
                          "length": { "type": "integer", "minimum": 1 },
                          "valueWidth": { "type": "integer", "minimum": 0 },
                          "labelType": { "type": "integer", "enum": [0, 1, 2] }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "role": {
      "type": "object",
      "required": ["name"],
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string", "minLength": 1, "maxLength": 50 },
        "isRequestor": { "type": "boolean", "default": false },
        "isOwner": { "type": "boolean", "default": false },
        "isActive": { "type": "boolean", "default": true }
      }
    },
    "status": {
      "type": "object",
      "required": ["name"],
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string", "minLength": 1, "maxLength": 50 },
        "order": { "type": "integer", "minimum": 0 },
        "isCompleted": { "type": "boolean", "default": false },
        "isCanceled": { "type": "boolean", "default": false },
        "isActive": { "type": "boolean", "default": true }
      }
    },
    "workflowStepAccessLine": {
      "type": "object",
      "required": ["field"],
      "additionalProperties": false,
      "properties": {
        "field": { "type": "string", "minLength": 1 },
        "editable": { "type": "boolean" },
        "visible": { "type": "boolean" },
        "sublineId": { "type": "integer", "minimum": 1 }
      }
    },
    "workflowStepAction": {
      "type": "object",
      "required": ["name", "role", "status"],
      "additionalProperties": false,
      "properties": {
        "key": {
          "type": "string",
          "minLength": 1,
          "description": "Stable spec key when WorkflowStepActionName is not unique. Omit when name is unique."
        },
        "name": { "type": "string" },
        "role": { "type": "string", "minLength": 1 },
        "status": { "type": "string", "minLength": 1 },
        "styleId": { "type": "integer", "minimum": 1 },
        "order": { "type": "integer", "minimum": 1 },
        "reopenOnSave": { "$ref": "#/$defs/reopenOnSave" },
        "isActive": {
          "type": "boolean",
          "description": "WorkflowStepAction.IsActive — false soft-disables the footer button (OT does not delete)"
        }
      }
    },
    "workflowStep": {
      "type": "object",
      "required": ["name", "role", "status"],
      "additionalProperties": false,
      "properties": {
        "key": {
          "type": "string",
          "minLength": 1,
          "description": "Stable spec key when WorkflowStepName is not unique (e.g. several Added by system). Omit when name is unique."
        },
        "name": { "type": "string" },
        "role": { "type": "string", "minLength": 1 },
        "status": { "type": "string", "minLength": 1 },
        "actions": {
          "type": "array",
          "items": { "$ref": "#/$defs/workflowStepAction" }
        },
        "access": {
          "type": "array",
          "items": { "$ref": "#/$defs/workflowStepAccessLine" }
        },
        "suppressSave": {
          "type": "boolean",
          "description": "WorkflowStepIsSuppressSave — hide footer Save; form buttons still save"
        },
        "isActive": {
          "type": "boolean",
          "description": "WorkflowStep.IsActive — false soft-disables the step (OT does not delete). spRefreshWorkflowStep may still deactivate untargeted steps."
        }
      }
    },
    "workflow": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "mode": { "type": "string", "enum": ["minimal", "full"] },
        "reuse": {
          "type": "boolean",
          "description": "Bind an existing Workflow Orig. ID. Generate omits Workflow, WorkflowStep, WorkflowStepAction, Role, and RequestStatus (and their LanguageTable). Still emits WorkflowStepAccess and ObjectDefault.WorkflowID."
        },
        "name": { "type": "string" },
        "steps": {
          "type": "array",
          "items": { "$ref": "#/$defs/workflowStep" }
        }
      }
    },
    "templateField": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "hidden": { "type": "boolean" },
        "mandatory": { "type": "boolean" },
        "alwaysDisabled": {
          "type": "boolean",
          "description": "ObjectDefaultLineIsDisabled — Admin Always disabled on the template line"
        },
        "autonumber": {
          "type": "string",
          "minLength": 1,
          "description": "Catalog key from autonumbers: → ObjectDefaultLineAutoNumberID. Text (3) only."
        },
        "defaultValue": {
          "type": ["string", "number"],
          "description": "ObjectDefaultLineValue, or ObjectDefaultLineDescMemo HTML when the field type is description_memo"
        },
        "hint": {
          "type": "string",
          "minLength": 1,
          "description": "ObjectDefaultLineHint — runtime field hint (plain or HTML). All types except empty_space. Canonical English; translations in languageTable.templateHints"
        },
        "clientCalculation": { "$ref": "#/$defs/clientCalculation" },
        "extended": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "hidden": { "type": "string" },
            "disabled": { "type": "string" },
            "mandatory": { "type": "string" }
          }
        }
      }
    },
    "clientCalculation": {
      "type": "object",
      "required": ["type"],
      "additionalProperties": false,
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "math",
            "string",
            "service",
            "date_add",
            "date_diff",
            "focus",
            "user_info",
            "device_info"
          ]
        },
        "expr": {
          "type": "string",
          "description": "Stored without the G4 prefix. Math/string expression, or for user_info/device_info a single {Placeholder} such as {UserName} or {DeviceIP}."
        }
      }
    },
    "reopenOnSave": {
      "type": "string",
      "enum": [
        "none",
        "close",
        "open-only-everytime",
        "open-with-actions",
        "open-only-assigned"
      ],
      "description": "ObjectDefaultReopenTypeID / ObjectUpdateActionReopenTypeID / WorkflowStepActionReopenTypeID. Omit or none/close = NULL (request closes after save). open-only-assigned stays open only if the user still has the request in Inbox."
    },
    "template": {
      "type": "object",
      "required": ["name"],
      "additionalProperties": false,
      "properties": {
        "key": { "type": "string" },
        "name": { "type": "string" },
        "isDefault": { "type": "boolean" },
        "order": { "type": "integer", "minimum": 0 },
        "accessOwnerLevel": { "type": "integer", "minimum": 0 },
        "isExternal": { "type": "integer", "enum": [0, 1] },
        "externalLink": { "type": "string" },
        "reopenOnSave": { "$ref": "#/$defs/reopenOnSave" },
        "fields": {
          "type": "object",
          "additionalProperties": { "$ref": "#/$defs/templateField" }
        },
        "access": {
          "type": "array",
          "description": "ObjectDefaultAccess — create-form visible/editable; omit refresh defaults (both true)",
          "items": { "$ref": "#/$defs/workflowStepAccessLine" }
        }
      }
    },
    "objectActionParamValue": {
      "oneOf": [
        { "type": "string" },
        { "type": "integer" },
        {
          "type": "object",
          "required": ["field"],
          "additionalProperties": false,
          "properties": { "field": { "type": "string" } }
        },
        {
          "type": "object",
          "required": ["role"],
          "additionalProperties": false,
          "properties": { "role": { "type": "string" } }
        },
        {
          "type": "object",
          "required": ["status"],
          "additionalProperties": false,
          "properties": { "status": { "type": "string" } }
        }
      ]
    },
    "objectAction": {
      "type": "object",
      "required": ["typeCode"],
      "additionalProperties": false,
      "properties": {
        "key": { "type": "string" },
        "name": { "type": "string" },
        "typeCode": { "type": "string" },
        "order": { "type": "integer", "minimum": 1 },
        "isActive": { "type": "boolean" },
        "workflowSteps": {
          "type": "array",
          "items": { "type": "string" }
        },
        "params": {
          "type": "object",
          "additionalProperties": { "$ref": "#/$defs/objectActionParamValue" }
        },
        "conditions": {
          "type": "array",
          "items": { "$ref": "#/$defs/actionCondition" }
        }
      }
    },
    "actionCondition": {
      "type": "object",
      "required": ["field", "type"],
      "additionalProperties": false,
      "properties": {
        "field": { "type": "string" },
        "type": { "type": "string" },
        "param1": { "type": ["string", "number"] },
        "param2": { "type": ["string", "number"] },
        "isActive": { "type": "boolean" }
      }
    },
    "periodicAction": {
      "type": "object",
      "required": ["typeCode"],
      "additionalProperties": false,
      "properties": {
        "key": { "type": "string" },
        "name": { "type": "string" },
        "typeCode": { "type": "string" },
        "order": { "type": "integer", "minimum": 1 },
        "isActive": { "type": "boolean" },
        "params": {
          "type": "object",
          "additionalProperties": { "$ref": "#/$defs/objectActionParamValue" }
        },
        "conditions": {
          "type": "array",
          "items": { "$ref": "#/$defs/actionCondition" }
        }
      }
    },
    "periodic": {
      "type": "object",
      "required": ["name"],
      "additionalProperties": false,
      "properties": {
        "key": { "type": "string" },
        "name": { "type": "string", "minLength": 1, "maxLength": 50 },
        "requestType": {
          "oneOf": [
            { "type": "string", "enum": ["all", "in_progress", "completed"] },
            { "type": "integer", "enum": [0, 10, 20] }
          ]
        },
        "cron": {
          "type": "string",
          "minLength": 1,
          "description": "Quartz 7-field CRON; emits Scheduler + spPeriodicExecute line"
        },
        "schedulerName": { "type": "string", "minLength": 1, "maxLength": 50 },
        "isActive": { "type": "boolean" },
        "conditions": {
          "type": "array",
          "items": { "$ref": "#/$defs/actionCondition" }
        },
        "actions": {
          "type": "array",
          "items": { "$ref": "#/$defs/periodicAction" }
        }
      }
    },
    "updateActionMessage": {
      "type": "object",
      "required": ["key"],
      "additionalProperties": false,
      "properties": {
        "key": { "type": "string", "minLength": 1 },
        "visible": { "type": "boolean" }
      }
    },
    "objectMessage": {
      "type": "object",
      "required": ["key", "name", "html"],
      "additionalProperties": false,
      "properties": {
        "key": { "type": "string", "minLength": 1 },
        "name": { "type": "string", "minLength": 1, "maxLength": 50 },
        "style": {
          "type": "string",
          "description": "ObjectMessageStyle slug: information | warning | error"
        },
        "styleId": { "type": "integer", "enum": [1, 2, 3] },
        "order": { "type": "integer" },
        "html": { "type": "string", "minLength": 1 },
        "isActive": { "type": "boolean" },
        "conditions": {
          "type": "array",
          "items": { "$ref": "#/$defs/actionCondition" }
        }
      }
    },
    "updateAction": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "key": { "type": "string" },
        "name": { "type": "string" },
        "order": { "type": "integer" },
        "template": { "type": "string" },
        "workflow": { "type": "string" },
        "isQuick": { "type": "boolean" },
        "reopenOnSave": { "$ref": "#/$defs/reopenOnSave" },
        "isActive": { "type": "boolean" },
        "tabFocus": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "left": { "type": ["string", "null"] },
            "right": { "type": ["string", "null"] }
          }
        },
        "access": {
          "type": "array",
          "items": { "$ref": "#/$defs/workflowStepAccessLine" }
        },
        "conditions": {
          "type": "array",
          "items": { "$ref": "#/$defs/actionCondition" }
        },
        "messages": {
          "type": "array",
          "items": { "$ref": "#/$defs/updateActionMessage" }
        }
      }
    },
    "idsExplicit": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "objectTypeId": { "type": "integer", "minimum": 1 },
        "objectId": { "type": "integer", "minimum": 1 },
        "companyId": { "type": "integer", "minimum": 1 },
        "objectDefaultId": { "type": "integer", "minimum": 1 },
        "objectDefaultExternalLink": { "type": "string" },
        "objectDefaultExternalLinks": { "type": "object", "additionalProperties": { "type": "string" } },
        "objectDefaultAccessOwnerLevel": { "type": "integer", "minimum": 0 },
        "objectDefaultIsExternal": { "type": "integer", "enum": [0, 1] },
        "workflowId": { "type": "integer", "minimum": 1 },
        "tabs": { "type": "object", "additionalProperties": { "type": "integer", "minimum": 1 } },
        "sections": { "type": "object", "additionalProperties": { "type": "integer", "minimum": 1 } },
        "fields": { "type": "object", "additionalProperties": { "type": "integer", "minimum": 1 } },
        "objectDefaultLines": { "type": "object", "additionalProperties": { "type": "integer", "minimum": 1 } },
        "objectDefaultAccess": { "type": "object", "additionalProperties": { "type": "integer", "minimum": 1 } },
        "templates": { "type": "object", "additionalProperties": { "type": "integer", "minimum": 1 } },
        "lookups": { "type": "object", "additionalProperties": { "type": "integer", "minimum": 1 } },
        "lookupValues": { "type": "object", "additionalProperties": { "type": "integer", "minimum": 1 } },
        "autonumbers": { "type": "object", "additionalProperties": { "type": "integer", "minimum": 1 } },
        "references": { "type": "object", "additionalProperties": { "type": "integer", "minimum": 1 } },
        "sources": { "type": "object", "additionalProperties": { "type": "integer", "minimum": 1 } },
        "sourceValues": { "type": "object", "additionalProperties": { "type": "integer", "minimum": 1 } },
        "sourceRefObjects": { "type": "object", "additionalProperties": { "type": "integer", "minimum": 1 } },
        "refObjectLines": { "type": "object", "additionalProperties": { "type": "integer", "minimum": 1 } },
        "workflowSteps": { "type": "object", "additionalProperties": { "type": "integer", "minimum": 1 } },
        "workflowStepActions": { "type": "object", "additionalProperties": { "type": "integer", "minimum": 1 } },
        "workflowStepAccess": { "type": "object", "additionalProperties": { "type": "integer", "minimum": 1 } },
        "objectLineOnGrid": { "type": "object", "additionalProperties": { "type": "integer", "minimum": 1 } },
        "roles": { "type": "object", "additionalProperties": { "type": "integer", "minimum": 1 } },
        "statuses": { "type": "object", "additionalProperties": { "type": "integer", "minimum": 1 } },
        "updateActions": { "type": "object", "additionalProperties": { "type": "integer", "minimum": 1 } },
        "objectUpdateAccess": { "type": "object", "additionalProperties": { "type": "integer", "minimum": 1 } },
        "objectUpdateActionConditions": { "type": "object", "additionalProperties": { "type": "integer", "minimum": 1 } },
        "objectUpdateMessages": { "type": "object", "additionalProperties": { "type": "integer", "minimum": 1 } },
        "objectMessages": { "type": "object", "additionalProperties": { "type": "integer", "minimum": 1 } },
        "objectMessageConditions": { "type": "object", "additionalProperties": { "type": "integer", "minimum": 1 } },
        "objectActions": { "type": "object", "additionalProperties": { "type": "integer", "minimum": 1 } },
        "objectActionParams": { "type": "object", "additionalProperties": { "type": "integer", "minimum": 1 } },
        "objectActionConditions": { "type": "object", "additionalProperties": { "type": "integer", "minimum": 1 } },
        "workflowStepObjectActions": { "type": "object", "additionalProperties": { "type": "integer", "minimum": 1 } },
        "periodics": { "type": "object", "additionalProperties": { "type": "integer", "minimum": 1 } },
        "periodicConditions": { "type": "object", "additionalProperties": { "type": "integer", "minimum": 1 } },
        "periodicActions": { "type": "object", "additionalProperties": { "type": "integer", "minimum": 1 } },
        "periodicActionParams": { "type": "object", "additionalProperties": { "type": "integer", "minimum": 1 } },
        "periodicActionConditions": { "type": "object", "additionalProperties": { "type": "integer", "minimum": 1 } },
        "schedulers": { "type": "object", "additionalProperties": { "type": "integer", "minimum": 1 } },
        "schedulerLines": { "type": "object", "additionalProperties": { "type": "integer", "minimum": 1 } },
        "schedulerLineParams": { "type": "object", "additionalProperties": { "type": "integer", "minimum": 1 } },
        "languageTables": { "type": "object", "additionalProperties": { "type": "integer", "minimum": 1 } }
      }
    },
    "ids": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "base": {
          "oneOf": [
            { "type": "integer", "minimum": 1 },
            {
              "type": "object",
              "additionalProperties": { "type": "integer", "minimum": 1 }
            }
          ]
        },
        "explicit": { "$ref": "#/$defs/idsExplicit" },
        "byTable": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "additionalProperties": { "type": "integer", "minimum": 1 }
          }
        }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "transfer": { "type": "string" },
        "objectId": { "type": "integer", "minimum": 1 },
        "objectCode": { "type": "string" },
        "extractedAt": { "type": "string" }
      }
    },
    "langMap": {
      "type": "object",
      "description": "UserLanguageCode → translated text. Omit en (canonical name lives on the entity column).",
      "additionalProperties": { "type": "string", "minLength": 1 }
    },
    "languageTableLine": {
      "type": "object",
      "description": "ObjectLineName translations plus optional ObjectLineOnGridName",
      "properties": {
        "onGrid": { "$ref": "#/$defs/langMap" }
      },
      "additionalProperties": { "type": "string", "minLength": 1 }
    },
    "languageTableObjectMessage": {
      "type": "object",
      "description": "ObjectMessageName translations plus optional HTML (ObjectMessageFormat)",
      "properties": {
        "html": { "$ref": "#/$defs/langMap" }
      },
      "additionalProperties": { "type": "string", "minLength": 1 }
    },
    "languageTable": {
      "type": "object",
      "additionalProperties": false,
      "description": "Metadata translations (LanguageTable). Keys are entity type then entity key then language.",
      "properties": {
        "object": { "$ref": "#/$defs/langMap" },
        "company": { "$ref": "#/$defs/langMap" },
        "objectType": { "$ref": "#/$defs/langMap" },
        "workflow": { "$ref": "#/$defs/langMap" },
        "tabs": {
          "type": "object",
          "additionalProperties": { "$ref": "#/$defs/langMap" }
        },
        "sections": {
          "type": "object",
          "additionalProperties": { "$ref": "#/$defs/langMap" }
        },
        "lines": {
          "type": "object",
          "additionalProperties": { "$ref": "#/$defs/languageTableLine" }
        },
        "templates": {
          "type": "object",
          "additionalProperties": { "$ref": "#/$defs/langMap" }
        },
        "roles": {
          "type": "object",
          "additionalProperties": { "$ref": "#/$defs/langMap" }
        },
        "statuses": {
          "type": "object",
          "additionalProperties": { "$ref": "#/$defs/langMap" }
        },
        "stepActions": {
          "type": "object",
          "additionalProperties": { "$ref": "#/$defs/langMap" }
        },
        "objectActions": {
          "type": "object",
          "additionalProperties": { "$ref": "#/$defs/langMap" }
        },
        "updateActions": {
          "type": "object",
          "additionalProperties": { "$ref": "#/$defs/langMap" }
        },
        "periodics": {
          "type": "object",
          "additionalProperties": { "$ref": "#/$defs/langMap" }
        },
        "periodicActions": {
          "type": "object",
          "additionalProperties": { "$ref": "#/$defs/langMap" }
        },
        "schedulers": {
          "type": "object",
          "additionalProperties": { "$ref": "#/$defs/langMap" }
        },
        "objectMessages": {
          "type": "object",
          "additionalProperties": { "$ref": "#/$defs/languageTableObjectMessage" }
        },
        "templateHints": {
          "type": "object",
          "description": "ObjectDefaultLineHint translations. Nested template key then field code. RowID is ObjectDefaultLineID.",
          "additionalProperties": {
            "type": "object",
            "additionalProperties": { "$ref": "#/$defs/langMap" }
          }
        }
      }
    }
  }
}
